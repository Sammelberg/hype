{
  "name": "hype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.10.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3004}",
    "build": "next build",
    "start": "next start -p ${PORT:-3005}",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && node node_modules/typescript-7/bin/tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "erechnung:proben": "tsx scripts/e-rechnung-proben.ts",
    "erechnung:pruefen": "bash scripts/pruefe-e-rechnung.sh .e-rechnung-proben",
    "knip": "knip",
    "analyze": "ANALYZE=true next build",
    "db:up": "docker compose up -d --wait postgres mailpit",
    "db:down": "docker compose down",
    "migrate": "tsx --env-file-if-exists=.env src/cms/db/migrate.ts && tsx --env-file-if-exists=.env scripts/migrate-buchung.ts",
    "migrate:create": "drizzle-kit generate --name",
    "migrate:create:buchung": "drizzle-kit generate --config drizzle.buchung.config.ts --name",
    "seed": "sh -c 'tsx --env-file-if-exists=.env scripts/seed.ts \"$@\" && tsx --env-file-if-exists=.env scripts/seed-buchung.ts \"$@\"' --",
    "cms:passwort": "tsx --env-file-if-exists=.env scripts/set-password.ts",
    "cms:geplant": "tsx --env-file-if-exists=.env scripts/geplant.ts",
    "cms:aufbewahrung": "tsx --env-file-if-exists=.env scripts/aufbewahrung.ts",
    "cms:buchung-takt": "tsx --env-file-if-exists=.env scripts/buchung-takt.ts",
    "cms:metadaten-entfernen": "tsx --env-file-if-exists=.env scripts/strip-media-metadata.ts",
    "init:project": "node scripts/init-project.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@number-flow/react": "^0.6.2",
    "@react-pdf/renderer": "^4.9.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.3",
    "embla-carousel-react": "^8.6.0",
    "feed": "^6.0.0",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "leva": "^0.10.1",
    "lexical": "^0.52.0",
    "lucide-react": "^1.48.0",
    "maath": "^0.10.8",
    "motion": "^13.4.3",
    "next": "^16.3.6",
    "next-safe-action": "^8.7.3",
    "nodemailer": "^10.0.12",
    "nuqs": "^2.10.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@reticlehq/next": "3.2.0",
    "@reticlehq/react": "3.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "oxlint": "^1.85.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
