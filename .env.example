# --- Required ---
# Local: `pnpm db:up` starts Postgres from docker-compose.yml
DATABASE_URL=postgres://starter:starter@localhost:5434/starter
NEXT_PUBLIC_SERVER_URL=http://localhost:3002

# --- Optional ---
# Where uploads are stored (default: ./media next to the app; a persistent volume in production)
MEDIA_DIR=
# Set in CI: the seed creates the e2e admin account with this password
E2E_ADMIN_PASSWORD=

# Data sovereignty: no Next.js usage telemetry
NEXT_TELEMETRY_DISABLED=1
