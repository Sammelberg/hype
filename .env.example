# --- Required ---
# Local: `pnpm db:up` starts Postgres from docker-compose.yml
DATABASE_URL=postgres://hype:hype@localhost:5436/hype
NEXT_PUBLIC_SERVER_URL=http://localhost:3004
# Signs the contact form's start time; at least 32 characters, own value per server:
# openssl rand -base64 32   (pnpm init:project writes one into .env)
FORM_SECRET=
# Publishes scheduled pages: the server's timer runs `pnpm cms:geplant` every few minutes.
# `openssl rand -base64 32`
CRON_SECRET=
# Seals the mailbox password of „E-Mail-Versand“ (at least 32 characters). Without it no mail
# goes out; a new value means entering the mailbox password once more in /admin/email-versand.
MAIL_SECRET=

# --- Optional ---
# Where uploads are stored (default: ./media next to the app; a persistent volume in production)
MEDIA_DIR=
# Set in CI: the seed creates the e2e admin account with this password
E2E_ADMIN_PASSWORD=

# Data sovereignty: no Next.js usage telemetry
NEXT_TELEMETRY_DISABLED=1
# "1": /next/bewegung (the motion demo) in a production build too; for e2e, never on a server.
MOTION_DEMO=

# "1": bookings pay their Anzahlung through the pretend checkout (/buchung/<link>/testzahlung).
# Development and CI only; never on a server.
ZAHLUNG_TEST=
