# --- Required ---
# Local: `pnpm db:up` starts Postgres from docker-compose.yml
DATABASE_URL=postgres://port:port@localhost:5433/port
# 32+ random chars: `openssl rand -hex 32`
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Optional: enabled automatically when set ---
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
# Media storage (S3-compatible). Without these, uploads are stored on local disk.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Data sovereignty: no Next.js usage telemetry
NEXT_TELEMETRY_DISABLED=1
