# Production settings for deploy/compose.yml. Copy to deploy/.env (never commit it) and fill in;
# deploy/einrichten.sh does both and generates the secrets.
# Generate a secret with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
# Values with spaces need double quotes: the scripts source this file.

# --- Site ---
NEXT_PUBLIC_SERVER_URL=https://schwarzwaldsystems.de
NEXT_TELEMETRY_DISABLED=1
# Signs the contact form's start time (at least 32 characters).
FORM_SECRET=
# Lets the timer publish scheduled pages (deploy/aufgabe.sh geplant; at least 32 characters).
CRON_SECRET=

# --- Database --- letters and digits only: it is used inside a URL.
POSTGRES_PASSWORD=
# Loopback port of Postgres on the host, for the image build; one no other stack uses.
POSTGRES_HOST_PORT=5437

# --- Shared entrance (the edge Caddy of this host) ---
EDGE_NETWORK=edge
