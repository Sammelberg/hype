# Caddy in front of the app (README → Эксплуатация на сервере): TLS from Let's Encrypt, the app
# only on localhost. Caddy trusts no incoming X-Forwarded-For and sets the client's own address,
# which the rate limits read. The domain comes from SITE_DOMAIN in Caddy's environment
# (e.g. /etc/default/caddy), then: sudo systemctl reload caddy
{$SITE_DOMAIN} {
	encode zstd gzip

	# Uploads go to their own route and may be up to 60 MB.
	request_body {
		max_size 64MB
	}

	reverse_proxy 127.0.0.1:3003
}
