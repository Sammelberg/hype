# Schwarzwald Systems (github.com/Sammelberg/start) on the server's shared entrance: this file goes
# to the edge's sites/ as schwarzwald.caddy, then `caddy reload`. Its app joins edge as
# schwarzwald-app (deploy/compose.yml). Caddy sets X-Forwarded-For to the client's own address,
# which the rate limits read; uploads may be up to 60 MB.
schwarzwaldsystems.de {
	encode zstd gzip
	header -Server
	request_body {
		max_size 64MB
	}
	reverse_proxy schwarzwald-app:3000
}

www.schwarzwaldsystems.de {
	redir https://schwarzwaldsystems.de{uri} permanent
}
